# Ralph Loop Configuration
# Generated by /ralph-loop setup

# --- Engine: which coding-agent CLI drives the loop ---
# claude   = Claude Code      (model: plain name, e.g. opus, sonnet)
# codex    = OpenAI Codex CLI (model: e.g. gpt-5.3-codex; empty = codex default)
# opencode = opencode         (model: provider/model, e.g. anthropic/claude-sonnet-4-5)
# ccrun    = ccrun (drives the Claude Code REPL in tmux — subscription pool, not the
#            metered API pool; model: plain name, e.g. sonnet, opus). Needs the ccrun
#            CLI: https://github.com/lperez37/ccrun
RALPH_ENGINE="claude"

# Model for the engine above. Empty = use the engine's own configured default.
# For claude an empty value falls back to "opus".
RALPH_MODEL="opus"
RALPH_DEFAULT_BUILD_ITERATIONS=25
RALPH_DEFAULT_PLAN_ITERATIONS=5
RALPH_PROJECT_GOAL="{{GOAL}}"
RALPH_GH_ISSUES="false"
RALPH_GH_LABEL="ralph-loop"
RALPH_VIKUNJA_TASK_ID=""
RALPH_COMPLETION_PROMISE=""
RALPH_TDD="false"
RALPH_PLAYWRIGHT="false"
RALPH_MAX_STALL=3
# Exponential backoff for Claude session/rate-limit failures across engines
# that surface Claude limits (not just ccrun). On a matching failed engine run,
# the loop retries the same iteration after this delay, then doubles up to max.
RALPH_LIMIT_BACKOFF_INITIAL_SECONDS=300
RALPH_LIMIT_BACKOFF_MAX_SECONDS=5400
# Pause between iterations in seconds (0 = no pause). Useful for long-running
# loops to throttle token / subscription usage. Override per-run with
# --iteration-delay SECONDS.
RALPH_ITERATION_DELAY=0
RALPH_DEV_CMD=""
RALPH_DEV_PORT=""
RALPH_NTFY_TOPIC="ralph-loop"
RALPH_NTFY_URL=""

# --- codex-specific ---
# Sandbox policy: read-only | workspace-write | danger-full-access.
# Empty = fully autonomous (--dangerously-bypass-approvals-and-sandbox), the
# closest analogue to Claude Code's --dangerously-skip-permissions.
RALPH_CODEX_SANDBOX=""

# --- opencode-specific ---
# Which opencode agent to run: build (can edit files) or plan (read-only).
RALPH_OPENCODE_AGENT="build"

# --- ccrun-specific ---
# Per-iteration hard timeout (seconds) for the ccrun engine. ccrun kills the tmux
# session and returns exit 124 if a single turn exceeds this.
RALPH_CCRUN_TIMEOUT=1500
