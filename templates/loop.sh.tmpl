#!/usr/bin/env bash
# Ralph Wiggum Loop — Supervised autonomous development
# Usage: ./loop.sh [plan|build|supervise] [max_iterations] [--delay DURATION] [--at TIME] [--iteration-delay SECONDS]
# Examples:
#   ./loop.sh                              # Build mode, default iterations
#   ./loop.sh plan                         # Plan mode
#   ./loop.sh build 50                     # Build mode, 50 iterations
#   ./loop.sh build --delay 3h             # Build mode, start in 3 hours
#   ./loop.sh build --at 01:30             # Build mode, start at 01:30
#   ./loop.sh build --iteration-delay 300  # Sleep 5 minutes between iterations
#   ./loop.sh supervise build 250          # Restart loop if it exits before work is complete

set -euo pipefail

# --- Load config (new location, fallback to legacy) ---
if [ -f .ralph/config.sh ]; then
    source .ralph/config.sh
elif [ -f .ralph-config ]; then
    source .ralph-config
fi

# --- Portable ISO timestamp (GNU date -Iseconds fallback) ---
iso_timestamp() {
    date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S'
}

# --- Defaults ---
DEFAULT_BUILD_ITERATIONS="${RALPH_DEFAULT_BUILD_ITERATIONS:-25}"
DEFAULT_PLAN_ITERATIONS="${RALPH_DEFAULT_PLAN_ITERATIONS:-5}"
ENGINE="${RALPH_ENGINE:-claude}"
MODEL="${RALPH_MODEL:-}"
LOG_DIR=".ralph/logs"
STATE_DIR=".ralph/state"
DELAY=""
START_AT=""
PROMPT_FILE=""
ITERATION_DELAY="${RALPH_ITERATION_DELAY:-0}"

# --- Help ---
show_help() {
    cat <<'HELP'
Ralph Wiggum Loop — Supervised autonomous development

USAGE
  ./loop.sh [command] [options]

COMMANDS
  build [N]           Build mode (default). N = max iterations (default: 25)
  plan [N]            Plan mode. N = max iterations (default: 5)
  supervise [CMD N]   Run CMD under a restart supervisor until monitorable work is complete
  status              Show progress from .ralph/state/progress.json
  clean               Remove .ralph/ directory (keep IMPLEMENTATION_PLAN.md)
  clean --all         Remove .ralph/ AND IMPLEMENTATION_PLAN.md
  help, --help, -h    Show this help

OPTIONS
  --delay DURATION           Delay start (e.g., 3h, 30m, 1h30m)
  --at TIME                  Start at specific time (e.g., 01:30, 23:00)
  --iteration-delay SECONDS  Pause N seconds between iterations (default: 0)
  --engine ENGINE            Override engine (claude | codex | opencode | ccrun)
  --model MODEL              Override model (default: engine-specific)
  --prompt FILE              Override prompt file

EXAMPLES
  ./loop.sh                              Build mode, default iterations
  ./loop.sh plan                         Generate implementation plan
  ./loop.sh build 50                     Build with 50 iterations
  ./loop.sh build --delay 3h             Start building in 3 hours
  ./loop.sh build --at 01:30             Start building at 01:30
  ./loop.sh build --iteration-delay 300  Sleep 5 min between iterations
  ./loop.sh supervise build 250          Restart build loop if it exits early
  ./loop.sh status                       Check loop progress
  ./loop.sh clean                        Remove .ralph/ artifacts

LIFECYCLE (via Claude Code skill)
  /ralph-loop setup "goal"        Scaffold project for Ralph loop
  /ralph-loop run [build|plan]    Run loop from within Claude session
  /ralph-loop resume              Pick up where last loop left off

CONFIG
  .ralph/config.sh                Loop settings (model, iterations, notifications)
  .ralph/prompt-build.md          Build mode prompt
  .ralph/prompt-plan.md           Plan mode prompt
HELP
    exit 0
}

# --- Parse arguments ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case $1 in
        help|--help|-h) show_help ;;
        --delay)  [ $# -lt 2 ] && echo "ERROR: --delay requires a value" && exit 1; DELAY="$2";       shift 2 ;;
        --at)     [ $# -lt 2 ] && echo "ERROR: --at requires a value" && exit 1;    START_AT="$2";    shift 2 ;;
        --engine) [ $# -lt 2 ] && echo "ERROR: --engine requires a value" && exit 1; ENGINE="$2";    shift 2 ;;
        --iteration-delay)
                  [ $# -lt 2 ] && echo "ERROR: --iteration-delay requires a value (seconds)" && exit 1
                  if ! [[ "$2" =~ ^[0-9]+$ ]]; then
                      echo "ERROR: --iteration-delay must be a non-negative integer (seconds), got: $2"
                      exit 1
                  fi
                  ITERATION_DELAY="$2"; shift 2 ;;
        --model)  [ $# -lt 2 ] && echo "ERROR: --model requires a value" && exit 1; MODEL="$2";      shift 2 ;;
        --prompt) [ $# -lt 2 ] && echo "ERROR: --prompt requires a value" && exit 1; PROMPT_FILE="$2"; shift 2 ;;
        *)        POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]:-}"

SUPERVISE=0
if [ "${1:-}" = "supervise" ]; then
    SUPERVISE=1
    shift
fi

# --- Resolve engine and model ---
case "$ENGINE" in
    claude|codex|opencode|ccrun) ;;
    *) echo "ERROR: Unknown engine '$ENGINE' (expected: claude, codex, opencode, ccrun)"; exit 1 ;;
esac
# Empty model means "use the engine's own default"; claude has no notion of a
# default model on the CLI, so fall back to opus there.
[ -z "$MODEL" ] && [ "$ENGINE" = "claude" ] && MODEL="opus"

# --- Engine invocation ---
# Reads the iteration prompt on stdin and runs the configured coding agent.
# All output (stdout+stderr) is streamed so the loop can scan it for completion
# signals (RALPH_COMPLETE / <promise>). Returns the agent's own exit code.
run_engine() {
    case "$ENGINE" in
        claude)
            claude -p \
                ${MODEL:+--model "$MODEL"} \
                --dangerously-skip-permissions \
                --verbose
            ;;
        codex)
            # `codex exec -` reads the prompt from stdin and runs non-interactively.
            if [ -n "${RALPH_CODEX_SANDBOX:-}" ]; then
                codex exec \
                    ${MODEL:+-m "$MODEL"} \
                    --sandbox "$RALPH_CODEX_SANDBOX" \
                    --skip-git-repo-check \
                    -
            else
                codex exec \
                    ${MODEL:+-m "$MODEL"} \
                    --dangerously-bypass-approvals-and-sandbox \
                    --skip-git-repo-check \
                    -
            fi
            ;;
        opencode)
            # opencode run takes the prompt as a positional arg (no stdin support),
            # so slurp stdin into a variable first. Model is provider/model format.
            local prompt
            prompt="$(cat)"
            opencode run \
                ${MODEL:+-m "$MODEL"} \
                --agent "${RALPH_OPENCODE_AGENT:-build}" \
                --dangerously-skip-permissions \
                "$prompt"
            ;;
        ccrun)
            # ccrun drives the interactive `claude` REPL inside a detached tmux session
            # (never `claude -p`), so usage stays on your Claude subscription instead of
            # the metered programmatic/API pool. Reads the prompt on stdin and prints the
            # final assistant message on stdout — same contract as `claude -p`.
            # Requires the ccrun CLI on PATH: https://github.com/lperez37/ccrun
            ccrun ${MODEL:+--model "$MODEL"} --cwd "$PWD" --timeout "${RALPH_CCRUN_TIMEOUT:-1500}"
            ;;
    esac
}

RALPH_LIMIT_BACKOFF_INITIAL_SECONDS="${RALPH_LIMIT_BACKOFF_INITIAL_SECONDS:-300}"
RALPH_LIMIT_BACKOFF_MAX_SECONDS="${RALPH_LIMIT_BACKOFF_MAX_SECONDS:-5400}"
LIMIT_BACKOFF_SECONDS="$RALPH_LIMIT_BACKOFF_INITIAL_SECONDS"

is_limit_failure() {
    local offset="$1"
    # Engine-agnostic Claude limit detection. ccrun wraps the interactive REPL,
    # while the claude engine uses `claude -p`; both emit human-readable limit
    # messages on failed runs.
    tail -c +"$((offset + 1))" "$LOG_FILE" 2>/dev/null | grep -Eiq \
        "ccrun: run failed: limit|You've hit your session limit|You've reached your .* limit|usage limit|rate limit|rate_limit|RateLimitError|too many requests|429|quota exceeded|/rate-limit-options"
}

sleep_after_limit() {
    local base_seconds="$LIMIT_BACKOFF_SECONDS"
    if [ "$base_seconds" -gt "$RALPH_LIMIT_BACKOFF_MAX_SECONDS" ]; then
        base_seconds="$RALPH_LIMIT_BACKOFF_MAX_SECONDS"
    fi
    local jitter_percent=$((75 + RANDOM % 51))
    local wait_seconds=$((base_seconds * jitter_percent / 100))
    echo "[Ralph] Claude session/rate limit detected. Sleeping ${wait_seconds}s before retry (${jitter_percent}% of capped base ${base_seconds}s; max tier ${RALPH_LIMIT_BACKOFF_MAX_SECONDS}s is jittered too)."
    notify "Ralph waiting on Claude limit" "Sleeping ${wait_seconds}s before retry on $CURRENT_BRANCH (${jitter_percent}% of ${base_seconds}s)" "hourglass"
    sleep "$wait_seconds"
    LIMIT_BACKOFF_SECONDS=$((base_seconds * 2))
    if [ "$LIMIT_BACKOFF_SECONDS" -gt "$RALPH_LIMIT_BACKOFF_MAX_SECONDS" ]; then
        LIMIT_BACKOFF_SECONDS="$RALPH_LIMIT_BACKOFF_MAX_SECONDS"
    fi
}

# --- Status command ---
if [ "${1:-}" = "status" ]; then
    if [ -f "$STATE_DIR/progress.json" ]; then
        echo "=== Ralph Loop Status ==="
        python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f\"Status:     {d.get('status', 'unknown')} ({d.get('health', 'unknown')})\")
print(f\"Engine:     {d.get('engine', 'claude')} ({d.get('model', '')})\")
print(f\"Iteration:  {d.get('iteration', 0)}/{d.get('max_iterations', 0)}\")
print(f\"Tasks:      {d.get('tasks_done', 0)}/{d.get('tasks_total', 0)} done, {d.get('tasks_pending', 0)} pending\")
print(f\"Task src:   {d.get('task_count_source', 'unknown')} reliable={d.get('task_count_reliable', False)}\")
print(f\"Stalls:     {d.get('stall_count', 0)}\")
print(f\"Branch:     {d.get('branch', 'unknown')}\")
print(f\"Last SHA:   {d.get('last_sha', 'none')}\")
print(f\"Stop:       {d.get('stop_reason') or '-'}\")
print(f\"Elapsed:    {d.get('elapsed', '-')}\")
print(f\"Updated:    {d.get('updated_at', '-')}\")
" < "$STATE_DIR/progress.json" 2>/dev/null || cat "$STATE_DIR/progress.json"
        echo "========================="
    else
        echo "No progress state found. Run ./loop.sh build first."
        if [ -f IMPLEMENTATION_PLAN.md ]; then
            DONE=$(grep -cE '(\- \[x\]|\*\*Status:\*\* \[x\])' IMPLEMENTATION_PLAN.md 2>/dev/null || echo 0)
            PENDING=$(grep -cE '(\- \[ \]|\*\*Status:\*\* \[ \])' IMPLEMENTATION_PLAN.md 2>/dev/null || echo 0)
            echo "IMPLEMENTATION_PLAN.md: $DONE done, $PENDING pending"
        fi
    fi
    exit 0
fi

# --- Clean command ---
if [ "${1:-}" = "clean" ]; then
    if [ -d "$STATE_DIR/loop.lock" ]; then
        LOCK_PID=$(cat "$STATE_DIR/loop.lock/pid" 2>/dev/null || echo "")
        if [ -n "$LOCK_PID" ] && kill -0 "$LOCK_PID" 2>/dev/null; then
            echo "WARNING: A Ralph loop is currently running (PID $LOCK_PID)."
            echo "         Cleaning now will break the running loop."
            echo "         Kill it first: kill $LOCK_PID"
            exit 1
        fi
    fi
    if [ "${2:-}" = "--all" ]; then
        rm -rf .ralph/ IMPLEMENTATION_PLAN.md
        echo "Removed .ralph/, IMPLEMENTATION_PLAN.md, and learnings."
    else
        # Preserve learnings across clean cycles
        LEARNINGS_BAK=""
        if [ -f .ralph/learnings.md ]; then
            LEARNINGS_BAK=$(mktemp)
            cp .ralph/learnings.md "$LEARNINGS_BAK"
        fi
        rm -rf .ralph/
        if [ -n "$LEARNINGS_BAK" ]; then
            mkdir -p .ralph
            mv "$LEARNINGS_BAK" .ralph/learnings.md
            echo "Removed .ralph/ directory. IMPLEMENTATION_PLAN.md and learnings.md preserved."
        else
            echo "Removed .ralph/ directory. IMPLEMENTATION_PLAN.md preserved."
        fi
    fi
    exit 0
fi

# --- Mode selection ---
if [ "${1:-}" = "plan" ]; then
    MODE="plan"
    PROMPT_FILE="${PROMPT_FILE:-.ralph/prompt-plan.md}"
    MAX_ITERATIONS=${2:-$DEFAULT_PLAN_ITERATIONS}
elif [ "${1:-}" = "build" ]; then
    MODE="build"
    PROMPT_FILE="${PROMPT_FILE:-.ralph/prompt-build.md}"
    MAX_ITERATIONS=${2:-$DEFAULT_BUILD_ITERATIONS}
elif [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    MODE="build"
    PROMPT_FILE="${PROMPT_FILE:-.ralph/prompt-build.md}"
    MAX_ITERATIONS=$1
else
    MODE="build"
    PROMPT_FILE="${PROMPT_FILE:-.ralph/prompt-build.md}"
    MAX_ITERATIONS=$DEFAULT_BUILD_ITERATIONS
fi

# --- Fallback to legacy prompt locations ---
if [ ! -f "$PROMPT_FILE" ]; then
    if [ "$MODE" = "plan" ] && [ -f "PROMPT_plan.md" ]; then
        PROMPT_FILE="PROMPT_plan.md"
    elif [ "$MODE" = "build" ] && [ -f "PROMPT_build.md" ]; then
        PROMPT_FILE="PROMPT_build.md"
    fi
fi

# --- Safety checks ---
if [ ! -f "$PROMPT_FILE" ]; then
    echo "ERROR: $PROMPT_FILE not found. Run scaffold.sh first (see README)."
    exit 1
fi

# --- Engine binary check ---
if ! command -v "$ENGINE" >/dev/null 2>&1; then
    echo "ERROR: '$ENGINE' CLI not found in PATH."
    case "$ENGINE" in
        claude)   echo "       Install Claude Code: https://docs.anthropic.com/en/docs/claude-code" ;;
        codex)    echo "       Install Codex CLI:   npm i -g @openai/codex  (https://developers.openai.com/codex/cli)" ;;
        opencode) echo "       Install opencode:    https://opencode.ai/docs" ;;
        ccrun) echo "       Install ccrun:       https://github.com/lperez37/ccrun" ;;
    esac
    exit 1
fi

if [ ! -f "AGENTS.md" ] && [ "$MODE" = "build" ]; then
    echo "WARNING: AGENTS.md not found. Ralph will have no backpressure commands."
fi

# --- Handle delayed start ---
parse_duration() {
    local input="$1"
    local total_seconds=0
    [[ "$input" =~ ([0-9]+)h ]] && total_seconds=$((total_seconds + ${BASH_REMATCH[1]} * 3600))
    [[ "$input" =~ ([0-9]+)m ]] && total_seconds=$((total_seconds + ${BASH_REMATCH[1]} * 60))
    [[ "$input" =~ ([0-9]+)s ]] && total_seconds=$((total_seconds + ${BASH_REMATCH[1]}))
    [[ "$input" =~ ^[0-9]+$ ]]  && total_seconds=$((input * 3600))
    echo "$total_seconds"
}

# GNU date check (--delay and --at need date -d which is GNU-only)
if [ -n "$START_AT" ] || [ -n "$DELAY" ]; then
    if ! date -d "1 second" +%s &>/dev/null; then
        echo "ERROR: --delay and --at require GNU date (coreutils)."
        echo "       On macOS: brew install coreutils && export PATH=\"\$(brew --prefix coreutils)/libexec/gnubin:\$PATH\""
        exit 1
    fi
fi

if [ -n "$START_AT" ]; then
    NOW_EPOCH=$(date +%s)
    TARGET_EPOCH=$(date -d "$START_AT" +%s 2>/dev/null || date -d "today $START_AT" +%s 2>/dev/null)
    if [ "$TARGET_EPOCH" -le "$NOW_EPOCH" ]; then
        TARGET_EPOCH=$(date -d "tomorrow $START_AT" +%s 2>/dev/null || echo "$TARGET_EPOCH")
    fi
    SLEEP_SECONDS=$((TARGET_EPOCH - NOW_EPOCH))
    if [ "$SLEEP_SECONDS" -gt 0 ]; then
        WAKE_TIME=$(date -d "@$TARGET_EPOCH" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
        echo "  zzZ  Ralph is napping until $WAKE_TIME ($SLEEP_SECONDS seconds)"
        echo "       Press Ctrl+C to cancel"
        sleep "$SLEEP_SECONDS"
    fi
elif [ -n "$DELAY" ]; then
    SLEEP_SECONDS=$(parse_duration "$DELAY")
    if [ "$SLEEP_SECONDS" -gt 0 ]; then
        WAKE_TIME=$(date -d "+${SLEEP_SECONDS} seconds" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
        echo "  zzZ  Ralph is napping for $DELAY ($SLEEP_SECONDS seconds)"
        echo "       Will start at: $WAKE_TIME"
        echo "       Press Ctrl+C to cancel"
        sleep "$SLEEP_SECONDS"
    fi
fi

# --- Dev server management (optional) ---
ensure_dev_server() {
    local dev_cmd="${RALPH_DEV_CMD:-}"
    local dev_port="${RALPH_DEV_PORT:-}"
    [ -z "$dev_cmd" ] && return 0
    [ -z "$dev_port" ] && return 0

    # Fast path: configured port responds. Nothing to do.
    if curl -s "http://localhost:$dev_port" > /dev/null 2>&1; then
        return 0
    fi

    # Port silent but we previously spawned a dev-server and it's still alive.
    # Almost always means the server auto-bumped to a different port because
    # $dev_port was taken, or $dev_port is misconfigured. Do NOT spawn another.
    if [ -n "${DEV_PID:-}" ] && kill -0 "$DEV_PID" 2>/dev/null; then
        echo "[Ralph] WARNING: DEV_PID $DEV_PID is alive but port $dev_port is not responding."
        echo "[Ralph]          Does RALPH_DEV_PORT match the port your dev server actually binds?"
        echo "[Ralph]          Not spawning a second instance. Check $LOG_DIR/dev-server.log"
        return 0
    fi

    # Port silent, no tracked PID, but a process matching $dev_cmd exists.
    # Likely started manually or in a previous run. Don't stack a duplicate.
    if pgrep -f -- "$dev_cmd" > /dev/null 2>&1; then
        echo "[Ralph] WARNING: A process matching '$dev_cmd' is already running,"
        echo "[Ralph]          but port $dev_port is not responding. Not re-spawning."
        echo "[Ralph]          Check RALPH_DEV_PORT or kill the stray process."
        return 0
    fi

    # Genuinely no dev server running. Start one.
    echo "[Ralph] Starting dev server: $dev_cmd"
    bash -c "$dev_cmd" &>"$LOG_DIR/dev-server.log" &
    DEV_PID=$!
    echo "[Ralph] Dev server PID: $DEV_PID"
    sleep 5
    if ! curl -s "http://localhost:$dev_port" > /dev/null 2>&1; then
        echo "[Ralph] WARNING: Dev server may not have started. Check $LOG_DIR/dev-server.log"
    fi
}

# --- Notification helper ---
NTFY_URL="${RALPH_NTFY_URL:-https://ntfy.sh/${RALPH_NTFY_TOPIC:-ralph-loop}}"

notify() {
    local title="${1//$'\n'/ }"
    local message="${2//$'\n'/ }"
    local tags="${3:-robot}"

    local cet_hour
    cet_hour=$(TZ="Europe/Amsterdam" date +%H)
    local priority="high"
    if [ "$cet_hour" -ge 0 ] && [ "$cet_hour" -lt 7 ]; then
        priority="min"
    fi

    curl -s -o /dev/null \
        -H "Title: $title" \
        -H "Priority: $priority" \
        -H "Tags: $tags" \
        -d "$message" \
        "$NTFY_URL" 2>/dev/null || true
}

elapsed() {
    local secs=$(( $(date +%s) - START_EPOCH ))
    local h=$((secs / 3600)) m=$(((secs % 3600) / 60))
    if [ "$h" -gt 0 ]; then echo "${h}h ${m}m"
    else echo "${m}m"; fi
}

# --- Count tasks in IMPLEMENTATION_PLAN.md ---
# Matches both markdown task checkboxes and "**Status:** [x]" field format.
# Ignores fenced code blocks so examples do not pollute monitoring counts.
task_progress_json() {
    if [ ! -f IMPLEMENTATION_PLAN.md ]; then
        printf '{"done":0,"pending":0,"total":0,"reliable":false}'
        return
    fi
    python3 - <<'PY'
import json, re
from pathlib import Path

task_re = re.compile(r'^\s*(?:[-*+]\s+)?\[( |x|X)\]\s+')
status_re = re.compile(r'^\s*\*\*Status:\*\*\s*\[( |x|X)\]', re.I)
fence_re = re.compile(r'^\s*```')
done = total = 0
in_fence = False
for line in Path('IMPLEMENTATION_PLAN.md').read_text(errors='ignore').splitlines():
    if fence_re.match(line):
        in_fence = not in_fence
        continue
    if in_fence:
        continue
    match = task_re.match(line) or status_re.match(line)
    if not match:
        continue
    total += 1
    if match.group(1) != ' ':
        done += 1
pending = max(total - done, 0)
print(json.dumps({
    'done': done,
    'pending': pending,
    'total': total,
    'reliable': total > 0,
}, separators=(',', ':')))
PY
}

count_tasks() {
    local status="$1"
    task_progress_json | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('$status', 0))"
}

# --- JSON helper ---
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    printf '%s' "$s"
}

# --- Write progress state ---
write_progress() {
    mkdir -p "$STATE_DIR"
    local status="${1:-running}"
    local stop_reason="${2:-}"
    local task_json tasks_done tasks_pending tasks_total task_reliable health task_source
    task_json=$(task_progress_json)
    tasks_done=$(printf '%s' "$task_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['done'])")
    tasks_pending=$(printf '%s' "$task_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['pending'])")
    tasks_total=$(printf '%s' "$task_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['total'])")
    task_reliable=$(printf '%s' "$task_json" | python3 -c "import json,sys; print(str(json.load(sys.stdin)['reliable']).lower())")
    if [ "$task_reliable" = "true" ]; then
        health="monitorable"
        task_source="IMPLEMENTATION_PLAN.md"
    elif [ -n "${RALPH_COMPLETION_PROMISE:-}" ]; then
        health="monitorable"
        task_source="completion_promise"
    else
        health="no_task_source"
        task_source="none"
    fi

    local branch_safe mode_safe model_safe engine_safe started_safe status_safe stop_reason_safe health_safe task_source_safe promise_safe
    branch_safe=$(json_escape "$CURRENT_BRANCH")
    mode_safe=$(json_escape "$MODE")
    model_safe=$(json_escape "$MODEL")
    engine_safe=$(json_escape "$ENGINE")
    started_safe=$(json_escape "$STARTED_AT")
    status_safe=$(json_escape "$status")
    stop_reason_safe=$(json_escape "$stop_reason")
    health_safe=$(json_escape "$health")
    task_source_safe=$(json_escape "$task_source")
    promise_safe=$(json_escape "${RALPH_COMPLETION_PROMISE:-}")

    local tmp
    tmp=$(mktemp "$STATE_DIR/progress.json.tmp.XXXXXX")

    cat > "$tmp" <<PROGRESS_EOF
{
  "iteration": $ITERATION,
  "max_iterations": $MAX_ITERATIONS,
  "mode": "$mode_safe",
  "engine": "$engine_safe",
  "model": "$model_safe",
  "branch": "$branch_safe",
  "last_sha": "$(git rev-parse --short HEAD 2>/dev/null || echo 'none')",
  "stall_count": $CONSECUTIVE_NO_CHANGES,
  "tasks_done": $tasks_done,
  "tasks_pending": $tasks_pending,
  "tasks_total": $tasks_total,
  "task_count_reliable": $task_reliable,
  "task_count_source": "$task_source_safe",
  "completion_promise": "$promise_safe",
  "started_at": "$started_safe",
  "updated_at": "$(iso_timestamp)",
  "elapsed": "$(elapsed)",
  "status": "$status_safe",
  "health": "$health_safe",
  "stop_reason": "$stop_reason_safe",
  "pid": $$
}
PROGRESS_EOF
    mv "$tmp" "$STATE_DIR/progress.json"
}

supervisor_should_restart() {
    local exit_code="$1"
    if [ ! -f "$STATE_DIR/progress.json" ]; then
        [ "$exit_code" -ne 0 ] && return 0
        return 1
    fi
    python3 - "$exit_code" "$STATE_DIR/progress.json" <<'PY'
import json, sys

exit_code = int(sys.argv[1])
with open(sys.argv[2], 'r', encoding='utf-8') as f:
    d = json.load(f)

status = d.get('status')
health = d.get('health')
stop = d.get('stop_reason')
pending = int(d.get('tasks_pending') or 0)
reliable = bool(d.get('task_count_reliable'))
has_promise = bool(d.get('completion_promise'))

restart = False
reason = 'complete'
if stop == 'done' or (reliable and pending == 0):
    restart = False
elif health == 'no_task_source' and not has_promise:
    restart = False
    reason = 'not_monitorable'
elif stop == 'circuit_breaker':
    restart = False
    reason = 'circuit_breaker'
elif reliable and pending > 0:
    restart = True
    reason = f'pending_tasks:{pending}'
elif has_promise and status in {'finished', 'failed', 'interrupted'}:
    restart = True
    reason = 'promise_not_fulfilled'
elif exit_code != 0:
    restart = True
    reason = f'exit_code:{exit_code}'
else:
    restart = False

print(json.dumps({'restart': restart, 'reason': reason}, separators=(',', ':')))
sys.exit(0 if restart else 1)
PY
}

write_supervisor_state() {
    mkdir -p "$STATE_DIR"
    local status="$1" restarts="$2" reason="$3" child_exit="$4"
    local tmp
    tmp=$(mktemp "$STATE_DIR/supervisor.json.tmp.XXXXXX")
    cat > "$tmp" <<SUPERVISOR_EOF
{
  "status": "$(json_escape "$status")",
  "restarts": $restarts,
  "last_reason": "$(json_escape "$reason")",
  "last_child_exit": $child_exit,
  "updated_at": "$(iso_timestamp)",
  "pid": $$
}
SUPERVISOR_EOF
    mv "$tmp" "$STATE_DIR/supervisor.json"
}

run_supervisor() {
    local max_restarts="${RALPH_SUPERVISOR_MAX_RESTARTS:-50}"
    local restart_delay="${RALPH_SUPERVISOR_RESTART_DELAY_SECONDS:-60}"
    local restarts=0 child_exit=0 decision reason
    mkdir -p "$LOG_DIR" "$STATE_DIR"
    echo "[Ralph supervisor] Starting: ./loop.sh $*"
    write_supervisor_state "running" "$restarts" "started" 0
    while true; do
        set +e
        "$0" "$@"
        child_exit=$?
        set -e

        decision=$(supervisor_should_restart "$child_exit" 2>/dev/null || true)
        reason=$(printf '%s' "$decision" | python3 -c "import json,sys; raw=sys.stdin.read(); print(json.loads(raw).get('reason','complete') if raw else 'complete')" 2>/dev/null || echo "complete")
        if ! printf '%s' "$decision" | grep -q '"restart":true'; then
            echo "[Ralph supervisor] Stopping: $reason"
            write_supervisor_state "stopped" "$restarts" "$reason" "$child_exit"
            return "$child_exit"
        fi

        restarts=$((restarts + 1))
        if [ "$restarts" -gt "$max_restarts" ]; then
            echo "[Ralph supervisor] Restart budget exhausted ($max_restarts). Last reason: $reason"
            write_supervisor_state "exhausted" "$restarts" "$reason" "$child_exit"
            return 1
        fi

        echo "[Ralph supervisor] Restarting after ${restart_delay}s ($reason, restart $restarts/$max_restarts)"
        write_supervisor_state "sleeping" "$restarts" "$reason" "$child_exit"
        if declare -F notify >/dev/null 2>&1; then
            notify "Ralph supervisor restart" "$reason; restart $restarts/$max_restarts on ${CURRENT_BRANCH:-unknown}" "warning"
        fi
        sleep "$restart_delay"
        write_supervisor_state "running" "$restarts" "$reason" "$child_exit"
    done
}

if [ "$SUPERVISE" = "1" ]; then
    [ $# -eq 0 ] && set -- build
    run_supervisor "$@"
    exit $?
fi

# --- Lock (atomic mkdir to prevent concurrent loops) ---
LOCK_DIR="$STATE_DIR/loop.lock"
mkdir -p "$LOG_DIR" "$STATE_DIR"
if mkdir "$LOCK_DIR" 2>/dev/null; then
    echo $$ > "$LOCK_DIR/pid"
else
    LOCK_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "unknown")
    if kill -0 "$LOCK_PID" 2>/dev/null; then
        echo "ERROR: Another Ralph loop is already running (PID $LOCK_PID)"
        echo "If this is stale, remove $LOCK_DIR manually."
        exit 1
    else
        # Stale lock from a crashed run, take over
        echo $$ > "$LOCK_DIR/pid"
    fi
fi

# --- Setup logging ---
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="$LOG_DIR/ralph_${MODE}_${TIMESTAMP}.log"
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
STARTED_AT=$(iso_timestamp)

echo ""
echo "  ralph ~ $MODE"
echo "  ─────────────────"
echo "  engine:     $ENGINE"
echo "  model:      ${MODEL:-<engine default>}"
echo "  iterations: $MAX_ITERATIONS"
echo "  branch:     $CURRENT_BRANCH"
echo "  prompt:     $PROMPT_FILE"
echo "  log:        $LOG_FILE"
echo "  started:    $(date '+%Y-%m-%d %H:%M:%S')"
PROMISE_CFG="${RALPH_COMPLETION_PROMISE:-}"
[ -n "$PROMISE_CFG" ] && echo "  promise:    $PROMISE_CFG"
[ "${RALPH_TDD:-false}" = "true" ] && echo "  tdd:        on"
[ -n "${RALPH_VIKUNJA_TASK_ID:-}" ] && echo "  vikunja:    #$RALPH_VIKUNJA_TASK_ID"
[ "${ITERATION_DELAY:-0}" -gt 0 ] && echo "  iter delay: ${ITERATION_DELAY}s between iterations"
echo ""

START_EPOCH=$(date +%s)

# --- Signal handling ---
cleanup() {
    echo ""
    echo "[Ralph] Interrupted. Writing final state..."
    write_progress "interrupted" "signal"
    notify "Ralph interrupted ($(elapsed))" "Stopped at iteration ${ITERATION:-0} on $CURRENT_BRANCH" "stop_sign"
    rm -rf "$LOCK_DIR"
    [ -n "${DEV_PID:-}" ] && kill "$DEV_PID" 2>/dev/null || true
    exit 1
}
trap cleanup SIGINT SIGTERM
trap 'rm -rf "$LOCK_DIR"' EXIT

# Start dev server if configured
ensure_dev_server

notify "Ralph started" "$MODE mode on $CURRENT_BRANCH. $MAX_ITERATIONS iterations, model: $MODEL" "rocket"

# --- Main loop ---
ITERATION=0
CONSECUTIVE_NO_CHANGES=0
MAX_NO_CHANGE_ITERATIONS="${RALPH_MAX_STALL:-3}"

while true; do
    if [ $MAX_ITERATIONS -gt 0 ] && [ $ITERATION -ge $MAX_ITERATIONS ]; then
        echo "[Ralph] Reached max iterations: $MAX_ITERATIONS"
        notify "Ralph done ($(elapsed))" "Reached max $MAX_ITERATIONS iterations on $CURRENT_BRANCH in $(elapsed)" "checkered_flag"
        STOP_REASON="max_iterations"
        break
    fi

    ITERATION=$((ITERATION + 1))
    echo ""
    echo "--- Iteration $ITERATION/$MAX_ITERATIONS [$MODE] $(date '+%H:%M:%S') ---"

    # Ensure dev server is alive
    ensure_dev_server

    # Track state for circuit breaker
    BEFORE_COMMITS=$(git rev-parse HEAD 2>/dev/null || echo "none")

    # Run Claude with fresh context
    LOG_OFFSET=$({ wc -c < "$LOG_FILE"; } 2>/dev/null || echo 0)

    set +e
    { echo "Ralph iteration $ITERATION/$MAX_ITERATIONS on branch $CURRENT_BRANCH"; cat "$PROMPT_FILE"; } | \
        run_engine 2>&1 | tee -a "$LOG_FILE"
    ENGINE_EXIT=${PIPESTATUS[1]:-$?}
    set -e

    if [ "${ENGINE_EXIT:-0}" -ne 0 ]; then
        echo "[Ralph] WARNING: $ENGINE exited with code $ENGINE_EXIT. Continuing loop..."
        if is_limit_failure "$LOG_OFFSET"; then
            ITERATION=$((ITERATION - 1))
            write_progress
            sleep_after_limit
            continue
        fi
    fi

    LIMIT_BACKOFF_SECONDS="$RALPH_LIMIT_BACKOFF_INITIAL_SECONDS"

    # Push changes
    git push origin "$CURRENT_BRANCH" 2>/dev/null || \
        git push -u origin "$CURRENT_BRANCH" 2>/dev/null || true

    # Circuit breaker: detect no-progress loops
    AFTER_COMMITS=$(git rev-parse HEAD 2>/dev/null || echo "none")

    if [ "$BEFORE_COMMITS" = "$AFTER_COMMITS" ]; then
        CONSECUTIVE_NO_CHANGES=$((CONSECUTIVE_NO_CHANGES + 1))
        echo "[Ralph] WARNING: No changes detected ($CONSECUTIVE_NO_CHANGES consecutive)"
        if [ $CONSECUTIVE_NO_CHANGES -ge $MAX_NO_CHANGE_ITERATIONS ]; then
            echo "[Ralph] CIRCUIT BREAKER: $MAX_NO_CHANGE_ITERATIONS iterations with no changes. Stopping."
            notify "Ralph stuck ($(elapsed))" "Circuit breaker after $ITERATION iterations on $CURRENT_BRANCH -- no changes detected" "warning"
            STOP_REASON="circuit_breaker"
            break
        fi
    else
        CONSECUTIVE_NO_CHANGES=0
    fi

    # Write progress
    write_progress

    # Check for completion signals (only in current iteration's output)

    # Check for <promise> tag (completion promise verification)
    COMPLETION_PROMISE="${RALPH_COMPLETION_PROMISE:-}"
    if [ -n "$COMPLETION_PROMISE" ]; then
        PROMISE_TEXT=$(tail -c +"$((LOG_OFFSET + 1))" "$LOG_FILE" 2>/dev/null | perl -0777 -ne \
            'if (/<promise>(.*?)<\/promise>/s) { $_ = $1; s/^\s+|\s+$//g; s/\s+/ /g; print }' \
            2>/dev/null || echo "")
        if [ -n "$PROMISE_TEXT" ]; then
            if [ "$PROMISE_TEXT" = "$COMPLETION_PROMISE" ]; then
                echo "[Ralph] Promise fulfilled: $COMPLETION_PROMISE"
                notify "Ralph promise fulfilled ($(elapsed))" "Promise: $COMPLETION_PROMISE — after $ITERATION iterations on $CURRENT_BRANCH in $(elapsed)" "white_check_mark"
                STOP_REASON="done"
                break
            else
                echo "[Ralph] Promise mismatch. Expected: '$COMPLETION_PROMISE', got: '$PROMISE_TEXT'"
            fi
        fi
    fi

    # Check for RALPH_COMPLETE (task-based completion)
    if tail -c +"$((LOG_OFFSET + 1))" "$LOG_FILE" 2>/dev/null | grep -q "RALPH_COMPLETE"; then
        echo "[Ralph] Completion signal detected. All tasks done!"
        notify "Ralph complete ($(elapsed))" "All tasks done after $ITERATION iterations on $CURRENT_BRANCH in $(elapsed)" "white_check_mark"
        STOP_REASON="done"
        break
    fi

    echo "[Ralph] Iteration $ITERATION complete. Restarting with fresh context..."

    # Optional pause between iterations (skip if next iteration would exit anyway)
    if [ "${ITERATION_DELAY:-0}" -gt 0 ]; then
        if [ $MAX_ITERATIONS -le 0 ] || [ $ITERATION -lt $MAX_ITERATIONS ]; then
            echo "[Ralph]   zzZ  Sleeping ${ITERATION_DELAY}s before next iteration (Ctrl+C to cancel)"
            sleep "$ITERATION_DELAY"
        fi
    fi
done

# --- Write final progress ---
ITERATION=${ITERATION:-0}
STOP_REASON="${STOP_REASON:-finished}"
write_progress "finished" "$STOP_REASON"
rm -rf "$LOCK_DIR"

# --- Post-run summary ---
echo ""
echo "  ralph ~ done"
echo "  ─────────────────"
echo "  iterations: $ITERATION"
echo "  elapsed:    $(elapsed)"
echo "  tasks:      $(count_tasks done)/$(count_tasks total) complete, $(count_tasks pending) remaining"
echo "  log:        $LOG_FILE"
echo ""

echo ""
echo "--- Git Summary ---"
[ "$ITERATION" -gt 0 ] && git log --oneline -"$ITERATION" 2>/dev/null || true
echo "-------------------"

# GitHub issues summary (if configured)
if [ "${RALPH_GH_ISSUES:-false}" = "true" ]; then
    echo ""
    echo "--- GitHub Issues ---"
    gh issue list --label "${RALPH_GH_LABEL:-ralph-loop}" --state all \
        --json number,title,state \
        --jq '.[] | "\(.state)\t#\(.number)\t\(.title)"' 2>/dev/null || true
    echo "---------------------"
fi

# Vikunja task summary (if configured)
if [ -n "${RALPH_VIKUNJA_TASK_ID:-}" ]; then
    echo ""
    echo "--- Vikunja Task #$RALPH_VIKUNJA_TASK_ID ---"
    echo "Subtask completion synced during build iterations."
    echo "Check full status: /vikunja get $RALPH_VIKUNJA_TASK_ID"
    echo "-------------------------------"
fi
